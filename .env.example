# Copy to .env (gitignored). Compose reads .env; the loader reads DATABASE_URL.
POSTGRES_USER=marvel
POSTGRES_PASSWORD=marvel
POSTGRES_DB=marvel
POSTGRES_PORT=5432

DATABASE_URL=postgresql://marvel:marvel@localhost:5432/marvel

# Read-only role for the future API backend (issue #20) — never used by the
# loader, which always writes as POSTGRES_USER above.
MARVEL_READONLY_PASSWORD=marvel_ro
API_DATABASE_URL=postgresql://marvel_readonly:marvel_ro@localhost:5432/marvel
